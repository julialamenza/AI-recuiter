# Backend (copy to backend/.env or export before running uvicorn)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recruiting
OPENAI_API_KEY=
# Stub AI (no OpenAI HTTP): leave key empty, or set MOCK_AI=true even with a key (e.g. CI).
MOCK_AI=false
OPENAI_MODEL=gpt-4o
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (copy to frontend/.env). Leave unset in dev to use Vite /api proxy.
# VITE_API_BASE_URL=http://localhost:8000
